{%- liquid
  assign p = section.settings
-%}

{%- style -%}
  #Popup-{{ section.id }} {
    --popup-radius: {{ p.corner_radius | default: 8 }}px;
  }

  /* The full-screen wrapper IS the black scrim. Hardcoded — no setting, no
     Liquid math, no CSS variable — so it can never render at zero alpha. */
  .popup-newsletter {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1.6rem;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .popup-newsletter[hidden] {
    display: none;
  }

  .popup-newsletter--visible {
    opacity: 1;
  }

  /* Invisible click-catcher for close-on-outside-click only. The dim lives on
     the wrapper above — do not add backgrounds here. */
  .popup-newsletter__overlay {
    position: absolute;
    inset: 0;
  }

  .popup-newsletter__dialog {
    position: relative;
    width: 100%;
    max-width: {{ p.max_width | default: 520 }}px;
    max-height: calc(100vh - 4rem);
    overflow-y: auto;
    /* Keep a tall card scrollable without the gesture chaining to the locked page. */
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--popup-radius);
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    box-shadow: 0 2.4rem 6.4rem rgba(0, 0, 0, 0.28);
    opacity: 0;
    transform: translateY(1.6rem) scale(0.98);
    transition: opacity 0.35s ease, transform 0.35s ease;
  }

  .popup-newsletter--visible .popup-newsletter__dialog {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .popup-newsletter,
    .popup-newsletter__dialog {
      transition: none;
    }
  }

  .popup-newsletter__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    box-shadow: 0 0.2rem 0.8rem rgba(0, 0, 0, 0.18);
    cursor: pointer;
  }

  .popup-newsletter__close svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .popup-newsletter__media {
    display: block;
    width: 100%;
  }

  .popup-newsletter__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .popup-newsletter__content {
    padding: 2.8rem 2.8rem 3.2rem;
    text-align: center;
  }

  .popup-newsletter__heading {
    margin: 0 0 1.2rem;
  }

  .popup-newsletter__subheading {
    margin: 0 0 0.8rem;
    font-size: 1.5rem;
  }

  .popup-newsletter__text {
    margin: 0 0 2rem;
    font-size: 1.4rem;
    opacity: 0.85;
  }

  .popup-newsletter__text > *,
  .popup-newsletter__subheading > * {
    margin: 0;
  }

  .popup-newsletter__form .field {
    margin-bottom: 1.2rem;
  }

  .popup-newsletter__button {
    width: 100%;
    margin-top: 0.4rem;
  }

  .popup-newsletter__decline {
    display: inline-block;
    margin-top: 1.6rem;
    background: none;
    border: 0;
    padding: 0;
    font-size: 1.3rem;
    text-decoration: underline;
    text-underline-offset: 0.3rem;
    cursor: pointer;
    color: inherit;
    opacity: 0.7;
  }

  .popup-newsletter__decline:hover {
    opacity: 1;
  }

  .popup-newsletter__message {
    margin-top: 1.2rem;
  }

  @media screen and (max-width: 749px) {
    .popup-newsletter__content {
      padding: 2.4rem 2rem 2.8rem;
    }
  }
{%- endstyle -%}

<div
  id="Popup-{{ section.id }}"
  class="popup-newsletter"
  role="dialog"
  aria-modal="true"
  aria-labelledby="PopupHeading-{{ section.id }}"
  hidden
  data-delay="{{ p.delay_seconds }}"
  data-frequency="{{ p.frequency_days }}"
  data-storage-key="artivia-popup-{{ section.id }}"
  data-mobile="{{ p.show_on_mobile }}"
  data-test-mode="{{ p.test_mode }}"
>
  <div class="popup-newsletter__overlay" data-popup-close></div>

  <div class="popup-newsletter__dialog color-{{ p.color_scheme }} gradient">
    <button
      type="button"
      class="popup-newsletter__close"
      aria-label="{{ 'accessibility.close' | t }}"
      data-popup-close
    >
      <span class="svg-wrapper">
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </button>

    {%- if p.image != blank -%}
      <div class="popup-newsletter__media">
        {{
          p.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 900, 1200',
            sizes: '(min-width: 750px) 520px, 90vw',
            alt: p.image.alt
        }}
      </div>
    {%- endif -%}

    <div class="popup-newsletter__content">
      <h2 id="PopupHeading-{{ section.id }}" class="popup-newsletter__heading {{ p.heading_size }}">
        {{ p.heading }}
      </h2>

      {%- if p.subheading != blank -%}
        <div class="popup-newsletter__subheading rte">{{ p.subheading }}</div>
      {%- endif -%}

      {%- if p.text != blank -%}
        <div class="popup-newsletter__text rte">{{ p.text }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'popup-newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, popup">

        {%- if p.show_first_name -%}
          <div class="field">
            <input
              id="PopupFirstName-{{ section.id }}"
              type="text"
              name="contact[first_name]"
              class="field__input"
              autocomplete="given-name"
              placeholder="{{ 'customer.register.first_name' | t }}"
            >
            <label class="field__label" for="PopupFirstName-{{ section.id }}">
              {{ 'customer.register.first_name' | t }}
            </label>
          </div>
        {%- endif -%}

        <div class="field">
          <input
            id="PopupEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="field__input"
            value="{{ form.email }}"
            aria-required="true"
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="{{ 'newsletter.label' | t }}"
            required
            {% if form.errors %}
              aria-invalid="true"
              aria-describedby="PopupError-{{ section.id }}"
            {% endif %}
          >
          <label class="field__label" for="PopupEmail-{{ section.id }}">
            {{ 'newsletter.label' | t }}
          </label>
        </div>

        <button type="submit" class="button button--primary popup-newsletter__button" name="commit">
          {{ p.button_label }}
        </button>

        {%- if form.errors -%}
          <small class="popup-newsletter__message form__message" id="PopupError-{{ section.id }}">
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            {{- form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email -}}
          </small>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <h3 class="popup-newsletter__message form__message" tabindex="-1" autofocus>
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            {%- if p.success_text != blank -%}
              {{- p.success_text -}}
            {%- else -%}
              {{- 'newsletter.success' | t -}}
            {%- endif -%}
          </h3>
        {%- endif -%}
      {%- endform -%}

      {%- if p.decline_label != blank -%}
        <button type="button" class="popup-newsletter__decline" data-popup-close>
          {{ p.decline_label }}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'popup-newsletter.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "class": "section-popup-newsletter",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a discount sign-up popup after a delay. Subscribers are tagged `newsletter, popup` in Shopify customers."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Get your exclusive discount",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" },
        { "value": "h0", "label": "t:sections.all.heading_size.options__3.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "default": "<p>Sign up to unlock your code.</p>",
      "label": "Subheading"
    },
    {
      "type": "richtext",
      "id": "text",
      "default": "<p>Plus stay in the loop with fresh content, promotions, freebies, and more!</p>",
      "label": "Body text"
    },
    {
      "type": "checkbox",
      "id": "show_first_name",
      "default": true,
      "label": "Show first name field"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Send me my discount",
      "label": "Button label"
    },
    {
      "type": "text",
      "id": "decline_label",
      "default": "No, thanks",
      "label": "Dismiss link label"
    },
    {
      "type": "text",
      "id": "success_text",
      "default": "Thanks for subscribing — check your inbox for your code.",
      "label": "Success message"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Delay before showing",
      "default": 5
    },
    {
      "type": "range",
      "id": "frequency_days",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "d",
      "label": "Days before showing again",
      "info": "Applies after a visitor dismisses or subscribes. 0 shows it on every page load.",
      "default": 14
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "default": true,
      "label": "Show on mobile"
    },
    {
      "type": "checkbox",
      "id": "test_mode",
      "default": false,
      "label": "Test mode",
      "info": "Ignores the dismissal cookie so the popup shows on every load. Turn off before going live."
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 320,
      "max": 720,
      "step": 20,
      "unit": "px",
      "label": "Popup width",
      "default": 520
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Corner radius",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
