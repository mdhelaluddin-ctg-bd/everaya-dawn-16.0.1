            "label_prefix": "Select",
            "recommended_values": "",
            "recommended_label": "Recommended"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "custom_message": {
          "type": "custom_message",
          "settings": {
            "label": "Write your sign off message (Optional)",
            "property_name": "Sign off message",
            "field_type": "text",
            "placeholder": "Write your sign off message \"i love you always and forever\"",
            "max_characters": 60,
            "required": false,
            "error_text": "Please add your message before adding to cart.",
            "highlight_label": true,
            "help_text": "This line prints at the bottom of the card",
            "badge_text": "Free"
          }
        },
        "delivery_estimate": {
          "type": "delivery_estimate",
          "settings": {}
        },
        "trust_badges": {
          "type": "trust_badges",
          "settings": {}
        },
        "collapsible_tab_1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "HAPPINESS GUARANTEE",
            "icon": "heart",
            "content": "<p><strong>100% HAPPINESS GUARANTEE</strong></p><p><br/>If your gift isn't right, please inform us within 14 days of delivery and we'll make it right — a replacement or a refund, your choice. Return shipping will be on the customer, except when an item arrives damaged, faulty, or incorrect, in which case we cover everything.</p>",
            "page": ""
          }
        },
        "collapsible_tab_2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "READY TO GIVE",
            "icon": "box",
            "content": "<p>All our products are presentably packaged for hassle-free gifting.</p>",
            "page": ""
          }
        },
        "collapsible_tab_3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "SHIPPING INFORMATION",
            "icon": "plane",
            "content": "<p><strong>Free shipping on every order.</strong><br/><br/><strong>Processing: 1–3 business days</strong><br/><br/>We print your message card and pack your gift by hand in our Florida facility before it ships.<br/><br/><strong>Then in transit:</strong><br/>US:      3–7 business days<br/>Canada:  5–12 business days<br/><br/><strong>Need it sooner</strong>? Express delivery is available <br/>for US orders — $11.99 at checkout, arriving in  4–7 business days total</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "custom_message",
        "quantity_selector",
        "buy_buttons",
        "delivery_estimate",
        "trust_badges",
        "collapsible_tab_1",
        "collapsible_tab_2",
        "collapsible_tab_3",
        "description"
