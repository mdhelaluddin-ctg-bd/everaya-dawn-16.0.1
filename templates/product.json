        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12,
        "breadcrumbs_position": "info_column",
        "breadcrumbs_home_label": "Home",
        "enable_sticky_atc": true,
        "cta_height": 60,
        "cta_radius": 10,
        "cta_font_size": 20,
        "cta_font_weight": "700",
        "cta_shadow": true,
        "variant_card_radius": 10,
        "variant_card_min_height": 54,
