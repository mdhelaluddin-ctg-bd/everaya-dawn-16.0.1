{%- comment -%}
  Floating add-to-cart bar, mobile only. Visible whenever the real add-to-cart
  button is off screen, and hidden while it is in view.

  It owns no state: the submit button is bound to the main product form via the
  `form` attribute (so adding reuses Dawn's AJAX add + cart drawer), and the
  quantity buttons proxy clicks to Dawn's <quantity-input>, which stays the
  single source of truth for min/max, quantity rules and volume pricing.

  Accepts: product, section
{%- endcomment -%}
{%- liquid
  assign sticky_form_id = 'product-form-' | append: section.id
  assign current_variant = product.selected_or_first_available_variant
  assign quantity_blocks = section.blocks | where: 'type', 'quantity_selector'
-%}
<sticky-atc
  class="sticky-atc"
  data-section-id="{{ section.id }}"
  hidden
>
  <div class="sticky-atc__inner page-width">
    {%- if quantity_blocks.size > 0 -%}
      <div class="sticky-atc__quantity">
        <button
          type="button"
          class="sticky-atc__quantity-button"
          data-sticky-quantity-step="minus"
        >
          <span class="visually-hidden">
            {{- 'products.product.quantity.decrease' | t: product: product.title | escape -}}
          </span>
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-minus.svg' | inline_asset_content -}}
          </span>
        </button>
        <span class="sticky-atc__quantity-value" data-sticky-quantity-value aria-hidden="true">
          {{- current_variant.quantity_rule.min -}}
        </span>
        <button
          type="button"
          class="sticky-atc__quantity-button"
          data-sticky-quantity-step="plus"
        >
          <span class="visually-hidden">
            {{- 'products.product.quantity.increase' | t: product: product.title | escape -}}
          </span>
          <span class="svg-wrapper" aria-hidden="true">
            {{- 'icon-plus.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
    {%- endif -%}
    <button
      type="submit"
      name="add"
      form="{{ sticky_form_id }}"
      class="sticky-atc__button button button--primary"
      {% if current_variant.available == false %}
        disabled
      {% endif %}
    >
      <span class="sticky-atc__button-text">
        {%- if current_variant.available -%}
          {{ 'products.product.add_to_cart' | t }}
        {%- else -%}
          {{ 'products.product.sold_out' | t }}
        {%- endif -%}
      </span>
      {%- render 'loading-spinner' -%}
    </button>
  </div>
</sticky-atc>
<script src="{{ 'sticky-atc.js' | asset_url }}" defer="defer"></script>
