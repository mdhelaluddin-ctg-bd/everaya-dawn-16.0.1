{%- comment -%}
  Gift options: gift-wrap toggle + gift-message textarea.
  Both are line-item properties attached to the product form via the
  HTML `form` attribute, so they submit on add-to-cart even though they
  render outside the <form>.
  Accepts: block, product_form_id
{%- endcomment -%}
{%- liquid
  assign wrap_label = block.settings.gift_wrap_label | default: 'Add gift wrap'
  assign message_label = block.settings.gift_message_label | default: 'Add a gift message'
-%}
<div class="gift-options quick-add-hidden" {{ block.shopify_attributes }}>
  {%- if block.settings.enable_gift_wrap -%}
    <label class="gift-options__row" for="GiftWrap-{{ block.id }}">
      <input
        type="checkbox"
        id="GiftWrap-{{ block.id }}"
        class="gift-options__checkbox"
        name="properties[Gift wrap]"
        value="Yes"
        form="{{ product_form_id }}"
      >
      <span class="gift-options__label">
        <span class="gift-options__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 12h18M12 8v13"/><path d="M12 8S9.5 3.5 7 5s1.5 3 5 3c3.5 0 5.5-1.5 5-3s-5 3-5 3z"/></svg>
        </span>
        <span>
          {{ wrap_label }}
          {%- if block.settings.gift_wrap_note != blank %}<span class="gift-options__note">{{ block.settings.gift_wrap_note }}</span>{% endif -%}
        </span>
      </span>
    </label>
  {%- endif -%}

  {%- if block.settings.enable_gift_message -%}
    <details class="gift-options__message">
      <summary class="gift-options__summary">
        <span class="gift-options__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M4 5h16v11H8l-4 4z"/><path d="M8 9h8M8 12h5"/></svg>
        </span>
        {{ message_label }}
      </summary>
      <textarea
        class="gift-options__textarea text-area field__input"
        name="properties[Gift message]"
        form="{{ product_form_id }}"
        rows="3"
        maxlength="250"
        placeholder="{{ block.settings.gift_message_placeholder | default: 'Write a short note for the recipient…' | escape }}"
      ></textarea>
    </details>
  {%- endif -%}
</div>
