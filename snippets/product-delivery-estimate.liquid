{% doc %}
  Renders a country-aware product delivery estimate using business-day offsets.

  @param {number} minimum_days - Fallback earliest delivery in business days.
  @param {number} maximum_days - Fallback latest delivery in business days.

  @example
  {% render 'product-delivery-estimate', minimum_days: 5, maximum_days: 7 %}
{% enddoc %}

{%- liquid
  assign delivery_minimum_days = minimum_days | default: 5
  assign delivery_maximum_days = maximum_days | default: 7

  case localization.country.iso_code
    when 'US'
      assign delivery_minimum_days = 3
      assign delivery_maximum_days = 7
    when 'CA'
      assign delivery_minimum_days = 4
      assign delivery_maximum_days = 9
  endcase
-%}

<delivery-estimate
  class="delivery-estimate"
  data-min-days="{{ delivery_minimum_days }}"
  data-max-days="{{ delivery_maximum_days }}"
  data-locale="{{ request.locale.iso_code | escape }}"
>
  <span class="delivery-estimate__icon" aria-hidden="true">
    <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M7 16.5 24 7l17 9.5v19L24 45 7 35.5v-19Z" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
      <path d="m7.5 16.5 16.5 9 16.5-9M24 25.5V45M15.5 11.8l17 9.4v7.2" stroke="currentColor" stroke-width="2.4" stroke-linejoin="round"/>
      <path d="M2 25h10M4 31h8M7 37h5" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    </svg>
  </span>
  <span class="delivery-estimate__content">
    <strong class="delivery-estimate__heading">
      {{- 'products.product.delivery_heading' | t -}}
    </strong>
    <span class="delivery-estimate__copy" aria-live="polite">
      {{- 'products.product.delivery_between' | t }}
      <time data-delivery-start>{{ 'products.product.delivery_calculating' | t }}</time>
      {{ 'products.product.delivery_and' | t }}
      <time data-delivery-end>{{ 'products.product.delivery_calculating' | t }}</time>.
    </span>
  </span>
</delivery-estimate>

{%- if localization.country.iso_code == 'US' -%}
  <div class="expedited-shipping" role="note">
    <span class="expedited-shipping__status" aria-hidden="true"></span>
    <span class="expedited-shipping__copy">
      <strong>{{ 'products.product.delivery_sooner' | t }}</strong>
      {{ 'products.product.delivery_priority' | t }}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .delivery-estimate {
    display: grid;
    grid-template-columns: 4.6rem minmax(0, 1fr);
    gap: 1.2rem;
    align-items: center;
    margin: 1.4rem 0 0.7rem;
    padding: 1.35rem 1.5rem;
    border: 0.1rem solid rgba(46, 170, 67, 0.35);
    border-left: 0.35rem solid #2eaa43;
    border-radius: 0.6rem;
    background: rgba(var(--color-background), 0.98);
    box-shadow: 0 0.5rem 1.6rem rgba(21, 65, 31, 0.06);
  }

  .delivery-estimate__icon {
    display: grid;
    width: 4.6rem;
    height: 4.6rem;
    place-items: center;
    color: #238b36;
  }

  .delivery-estimate__icon svg {
    width: 100%;
    height: 100%;
  }

  .delivery-estimate__content,
  .delivery-estimate__copy {
    display: block;
  }

  .delivery-estimate__heading {
    display: block;
    color: rgb(var(--color-foreground));
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .delivery-estimate__copy {
    margin-top: 0.25rem;
    color: rgba(var(--color-foreground), 0.72);
    font-size: 1.3rem;
    line-height: 1.45;
  }

  .delivery-estimate__copy time {
    color: #238b36;
    font-weight: 700;
  }

  .expedited-shipping {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.4rem;
    padding: 1.1rem 1.35rem;
    border: 0.1rem solid rgba(var(--color-foreground), 0.28);
    border-radius: 0.5rem;
    background: rgba(var(--color-background), 0.98);
    color: rgba(var(--color-foreground), 0.78);
    font-size: 1.2rem;
    line-height: 1.4;
  }

  .expedited-shipping__status {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: #2eaa43;
    box-shadow: 0 0 0 0.5rem rgba(46, 170, 67, 0.1);
  }

  .expedited-shipping__copy strong {
    color: rgb(var(--color-foreground));
    font-size: 1.15rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .delivery-estimate {
      grid-template-columns: 4rem minmax(0, 1fr);
      gap: 1rem;
      padding: 1.2rem;
    }

    .delivery-estimate__icon {
      width: 4rem;
      height: 4rem;
    }

    .expedited-shipping {
      padding: 1rem 1.2rem;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('delivery-estimate')) {
    customElements.define(
      'delivery-estimate',
      class DeliveryEstimate extends HTMLElement {
        connectedCallback() {
          const minimumDays = Math.max(1, Number(this.dataset.minDays) || 5);
          const maximumDays = Math.max(minimumDays, Number(this.dataset.maxDays) || 7);
          const locale = this.dataset.locale || document.documentElement.lang || 'en';
          const formatter = new Intl.DateTimeFormat(locale, {
            weekday: 'long',
            month: 'short',
            day: 'numeric',
          });

          const addBusinessDays = (days) => {
            const date = new Date();
            date.setHours(12, 0, 0, 0);
            let addedDays = 0;

            while (addedDays < days) {
              date.setDate(date.getDate() + 1);
              const weekday = date.getDay();
              if (weekday !== 0 && weekday !== 6) addedDays += 1;
            }

            return date;
          };

          const updateDate = (selector, date) => {
            const element = this.querySelector(selector);
            if (!element) return;
            element.textContent = formatter.format(date);
            element.dateTime = date.toISOString().slice(0, 10);
          };

          updateDate('[data-delivery-start]', addBusinessDays(minimumDays));
          updateDate('[data-delivery-end]', addBusinessDays(maximumDays));
        }
      }
    );
  }
{% endjavascript %}
