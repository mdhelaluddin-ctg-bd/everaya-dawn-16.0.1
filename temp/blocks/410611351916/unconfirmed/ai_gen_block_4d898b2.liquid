{% doc %}
  @prompt
    Modify the Delivery estimate block in the product page so that the icon is right-aligned within its column. The icon should appear on the right side of the row/column, while the text remains on the left. Maintain the premium, elegant look of the block.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-delivery-estimate-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-delivery-estimate-{{ ai_gen_id }}__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 24px;
    min-height: 68px;
    padding: 16px 0;
    border-top: 1px solid {{ block.settings.border_color }};
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-delivery-estimate-{{ ai_gen_id }}__content {
    min-width: 0;
    text-align: left;
  }

  .ai-delivery-estimate-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 5px;
    color: {{ block.settings.eyebrow_color }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ai-delivery-estimate-{{ ai_gen_id }}__text {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-delivery-estimate-{{ ai_gen_id }}__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    justify-self: end;
    width: 42px;
    height: 42px;
    color: {{ block.settings.icon_color }};
    border: 1px solid {{ block.settings.icon_border_color }};
    border-radius: 50%;
  }

  .ai-delivery-estimate-{{ ai_gen_id }}__icon svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-delivery-estimate-{{ ai_gen_id }}__row {
      column-gap: 16px;
    }
  }
{% endstyle %}

<div class="ai-delivery-estimate-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-delivery-estimate-{{ ai_gen_id }}__row">
    <div class="ai-delivery-estimate-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}
        <p class="ai-delivery-estimate-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      {% endif %}
      <p class="ai-delivery-estimate-{{ ai_gen_id }}__text">{{ block.settings.delivery_text | escape }}</p>
    </div>
    <div class="ai-delivery-estimate-{{ ai_gen_id }}__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <path d="M3 6.5h11v10H3z"></path>
        <path d="M14 10h3.5L21 13.5v3H14z"></path>
        <path d="M6.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path>
        <path d="M17.5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"></path>
      </svg>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Delivery estimate",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Delivery estimate"
    },
    {
      "type": "text",
      "id": "delivery_text",
      "label": "Message",
      "default": "Order today for complimentary delivery"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "icon_border_color",
      "label": "Icon border",
      "default": "#c8c8c8"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Divider",
      "default": "#dedede"
    }
  ],
  "presets": [
    {
      "name": "Delivery estimate"
    }
  ],
  "tag": null,
  "class": "delivery-estimate-block"
}
{% endschema %}